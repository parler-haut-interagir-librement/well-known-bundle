{
    "name": "phil/well-known-bundle",
    "description": "The /.well-known/ addresses of a Symfony site: security.txt, change-password, WebFinger, NodeInfo, did:web, DID configuration, AT Protocol handle, app links, and documents of other bundles",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "well-known",
        "security.txt",
        "webfinger",
        "nodeinfo",
        "did",
        "atproto",
        "app-links",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "psr/clock": "^1.0",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/http-foundation": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/routing": "^8.2"
    },
    "require-dev": {
        "phil/monitoring-bundle": "^0.1@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/browser-kit": "^8.2",
        "symfony/clock": "^8.2",
        "symfony/framework-bundle": "^8.2"
    },
    "suggest": {
        "phil/monitoring-bundle": "To check that the security.txt has not expired, and to be told before it does"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\WellKnownBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\WellKnownBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
